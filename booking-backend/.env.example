# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/lorraine-bookings?retryWrites=true&w=majority

# Server Configuration
PORT=3000
NODE_ENV=development

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Admin Authentication
ADMIN_PASSWORD_HASH=$2b$10$yourhashedpasswordhere
JWT_SECRET=your_jwt_secret_key_change_this_to_random_string

# Email Configuration (Optional - using Resend)
RESEND_API_KEY=re_your_resend_api_key
ADMIN_EMAIL=lorraine@example.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8000
